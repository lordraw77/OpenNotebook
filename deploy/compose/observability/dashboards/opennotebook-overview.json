{
  "uid": "opennotebook-overview",
  "title": "OpenNotebook overview",
  "tags": [
    "opennotebook"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "API availability (24 h, non-5xx)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(opennotebook_http_requests_total{status=~\"5..\"}[24h])) or vector(0)) / clamp_min(sum(increase(opennotebook_http_requests_total[24h])), 1)"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Chat TTFT p95 (1 h)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(opennotebook_chat_time_to_first_token_seconds_bucket{mode=\"chat\"}[1h])))"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Jobs waiting",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(opennotebook_queue_depth)"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Failed sources",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opennotebook_sources{status=\"failed\"}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "API requests by status",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(opennotebook_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "API latency p95 by route",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(opennotebook_http_request_duration_seconds_bucket{route!~\"/api/conversations/.*/messages\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Chat time to first token",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, mode) (rate(opennotebook_chat_time_to_first_token_seconds_bucket[15m])))",
          "legendFormat": "p50 {{mode}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(opennotebook_chat_time_to_first_token_seconds_bucket[15m])))",
          "legendFormat": "p95 {{mode}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Chat answers",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode, status) (increase(opennotebook_chat_answers_total[1h]))",
          "legendFormat": "{{mode}} {{status}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Provider calls by outcome",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, outcome) (rate(opennotebook_provider_calls_total[5m]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Provider latency p95",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider, phase) (rate(opennotebook_provider_call_duration_seconds_bucket[15m])))",
          "legendFormat": "{{provider}} {{phase}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opennotebook_queue_depth",
          "legendFormat": "{{queue}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Sources by status",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opennotebook_sources",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Ingestion jobs",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, status) (increase(opennotebook_ingestion_jobs_total[15m]))",
          "legendFormat": "{{kind}} {{status}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Ingestion duration p95",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(opennotebook_ingestion_duration_seconds_bucket[30m])))",
          "legendFormat": "{{kind}}"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Summaries and graph extraction",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task, outcome) (increase(opennotebook_background_tasks_total[1h]))",
          "legendFormat": "{{task}} {{outcome}}"
        }
      ],
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Retrieval p95",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(opennotebook_retrieval_duration_seconds_bucket[15m])))",
          "legendFormat": "retrieval"
        }
      ],
      "id": 16
    }
  ]
}
