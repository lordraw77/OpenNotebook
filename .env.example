# OpenNotebook environment configuration.
# Copy to .env (or run `make secrets`, which also fills the internal secrets) and add provider keys.
# Never commit .env.
#
# Format rule: comments go on their own line. Docker Compose does NOT strip inline comments,
# so `KEY=   # note` would set KEY to the text of the note.
#
# Provider keys are imported into the encrypted provider registry at first start;
# afterwards manage them in Settings -> Providers.

# --- Application --------------------------------------------------------------
# development | production
APP_ENV=development
APP_PUBLIC_URL=http://localhost:8080
# Random 64+ characters (generated by `make secrets`)
APP_SECRET_KEY=
# Base64 32-byte master key that encrypts provider keys (generated by `make secrets`; back it up)
APP_ENCRYPTION_KEY=
# en | it
APP_DEFAULT_LANGUAGE=en
LOG_LEVEL=INFO
# Maximum nesting depth of the project / workspace / notebook tree
NODE_MAX_DEPTH=16

# --- Model providers (leave empty to disable) --------------------------------
# No model runs inside OpenNotebook: every model call goes to one of these providers.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
# Existing external Ollama server, e.g. http://<ollama-host>:11434
OLLAMA_API_BASE=

# Default timeout per provider call, seconds
PROVIDER_TIMEOUT_S=60
# Timeout for Ollama (raise it for slow CPU-only servers)
OLLAMA_TIMEOUT_S=600

# --- Default model per phase (imported at first start; then edit in Settings -> Models)
# Format: <provider>/<model>; a comma-separated list is a fallback chain.
# <provider> is the provider name in OpenNotebook (the kind when imported from this file).
# These are global defaults; project owners can override any phase per project.
# Example: MODEL_CHAT=groq/openai/gpt-oss-20b,gemini/gemini-2.5-flash
MODEL_CHAT=
MODEL_SUMMARY=
MODEL_GRAPH_EXTRACTION=
MODEL_VISION=
# Example: MODEL_OCR=mistral/mistral-ocr-latest
MODEL_OCR=
# Exactly one model, pinned per index (no fallback). Example: MODEL_EMBEDDING=mistral/mistral-embed
MODEL_EMBEDDING=
# Optional; empty = rerank disabled
MODEL_RERANK=

# --- Compose ------------------------------------------------------------------
# Optional profiles to enable, comma-separated: auth,observability
COMPOSE_PROFILES=
# Image version and registry namespace: images are <REGISTRY>/opennotebook-{web,api,worker}:<VERSION>
# (published on Docker Hub as lordraw/opennotebook-*; use e.g. ghcr.io/<org> for your own registry)
VERSION=0.5.1
REGISTRY=lordraw
# Interface and port of the web UI
WEB_BIND=0.0.0.0
WEB_PORT=8080
# Used only by the auth profile (generated by `make secrets`)
KEYCLOAK_ADMIN_PASSWORD=
# auth profile: interface of Keycloak's port and the URL browsers use to reach it (issuer of the tokens)
KEYCLOAK_BIND=127.0.0.1
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8081
# Used only by the observability profile (generated by `make secrets`)
GRAFANA_ADMIN_PASSWORD=

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opennotebook
POSTGRES_USER=opennotebook
# Generated by `make secrets`
POSTGRES_PASSWORD=

# --- Qdrant -------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# Generated by `make secrets`
QDRANT_API_KEY=

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Generated by `make secrets`
REDIS_PASSWORD=

# --- Object storage -----------------------------------------------------------
# s3 (SeaweedFS by default, or Garage / any S3) | filesystem
STORAGE_BACKEND=s3
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=opennotebook
S3_REGION=us-east-1
# Generated by `make secrets`
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Used when STORAGE_BACKEND=filesystem
FILESYSTEM_ROOT=/data/blobs

# --- Ingestion ----------------------------------------------------------------
# Maximum size of one uploaded file
UPLOAD_MAX_MB=500
# Chunk size and overlap (estimated tokens)
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
# Texts per embedding request (lower it for providers with small batch limits)
EMBED_BATCH_SIZE=32
# Attempts for provider errors before a source is marked failed (exponential backoff, max 10 min)
INGESTION_MAX_ATTEMPTS=5
# Timeout for interactive calls (search query embedding); background jobs use the provider timeout
SEARCH_TIMEOUT_S=30

# --- Grounded chat ------------------------------------------------------------
# Passages retrieved by hybrid search for each question (before rerank and diversification)
CHAT_CANDIDATES=40
# Passages given to the chat model (numbered S1..Sn)
CHAT_CONTEXT_CHUNKS=10
# At most this many passages from the same source
CHAT_MAX_PER_SOURCE=4
# Previous messages sent with each question
CHAT_HISTORY_MESSAGES=6
# Maximum length of an answer (tokens)
CHAT_MAX_TOKENS=2048
# Rerank call timeout; on timeout or error the fusion order is kept
RERANK_TIMEOUT_S=20
# Time the chat model has to start answering before the next model of the chain is tried
CHAT_FIRST_TOKEN_TIMEOUT_S=60
# --- Archives -----------------------------------------------------------------
# Archives (ZIP, TAR, TAR.GZ/BZ2/XZ): each file becomes a source. Exceeding a limit rejects the archive.
ARCHIVE_MAX_UNCOMPRESSED_MB=2048
ARCHIVE_MAX_FILES=20000
# Nesting levels of archives inside archives
ARCHIVE_MAX_DEPTH=3
# Maximum uncompressed/compressed ratio (zip bomb protection)
ARCHIVE_MAX_RATIO=100
# Index images found inside archives (one OCR and one vision call each)
ARCHIVE_INDEX_IMAGES=false

# --- Images and scanned PDF pages (OCR + description by external models) ------
# Larger images are rejected (decompression bomb protection)
IMAGE_MAX_PIXELS=50000000
# Longest side of the image sent to OCR / vision providers
IMAGE_MAX_SIDE=2048
# Scanned pages transcribed per PDF
OCR_MAX_PAGES=50

# --- Web pages ----------------------------------------------------------------
WEB_MAX_MB=20
WEB_TIMEOUT_S=30
WEB_MAX_REDIRECTS=5
# true allows private, loopback and link-local addresses (intranet sites); keep false for SSRF protection
WEB_ALLOW_PRIVATE=false
# Limits for "follow links" (same site only, robots.txt respected)
WEB_CRAWL_MAX_DEPTH=2
WEB_CRAWL_MAX_PAGES=50
# The User-Agent can be changed with WEB_USER_AGENT (quote the value if it contains spaces)

# --- Knowledge graph and wiki -----------------------------------------------------
# Entities and relations per source ("graph_extraction" model chain; source code needs no model)
GRAPH_ENABLED=true
# Chunks of one source sent to the extraction model, and characters per request
GRAPH_MAX_CHUNKS_PER_SOURCE=200
GRAPH_BATCH_CHARS=8000
# Chat: passages added from the neighbours of the entities found in the retrieved passages (0 = off)
CHAT_GRAPH_EXPANSION_CHUNKS=4
# Wiki pages: passages given to the model, and time allowed to write the page
WIKI_MAX_PASSAGES=12
WIKI_TIMEOUT_S=120

# --- Deep research mode ---------------------------------------------------------
# Sub-questions planned per research, passages given to the report, report length (tokens)
RESEARCH_MAX_SUB_QUESTIONS=5
RESEARCH_MAX_PASSAGES=24
RESEARCH_MAX_TOKENS=4096

# --- Summaries ----------------------------------------------------------------
# Summary and suggested questions for each top-level document (uses the "summary" model chain)
SUMMARY_ENABLED=true
# Characters of the document sent to the summary model
SUMMARY_INPUT_CHARS=12000

# --- Authentication -----------------------------------------------------------
# local = passwords | oidc = single sign-on only | both
AUTH_MODE=local
# OpenID Connect provider (e.g. Keycloak: http://keycloak:8081/realms/<realm>, reachable from the api container).
# Redirect URI to register at the provider: <APP_PUBLIC_URL>/api/auth/oidc/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Label of the sign-in button
OIDC_LABEL=Single sign-on
# Create the account at the first SSO sign-in (false: an administrator creates it first)
OIDC_AUTO_CREATE_USERS=true
# Token claim with the user's groups, synchronized into OpenNotebook groups at each sign-in
OIDC_GROUPS_CLAIM=groups
OIDC_SYNC_GROUPS=true
# Comma-separated provider groups whose members are administrators (empty: admin role not managed by SSO)
OIDC_ADMIN_GROUPS=
OIDC_ALLOW_UNVERIFIED_EMAIL=false
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=604800
# First administrator, created at first start when no user exists
BOOTSTRAP_ADMIN_EMAIL=
# Generated by `make secrets`; used only once
BOOTSTRAP_ADMIN_PASSWORD=
